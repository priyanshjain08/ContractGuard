# ---- Database / Redis -------------------------------------------------------
DATABASE_URL=postgresql://contractguard:contractguard@localhost:5432/contractguard?schema=public
REDIS_URL=redis://localhost:6379

# ---- API --------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API (CORS + CSRF origin check).
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Set to "true" ONLY for local testing of URL imports over http://
ALLOW_HTTP_IMPORT=false

# ---- Web --------------------------------------------------------------------
# Where the Next.js server proxies /api/* to.
API_URL=http://localhost:4000

# ---- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=4

# ---- GitHub App (optional) --------------------------------------------------
GITHUB_APP_ID=
# PEM private key; use \n for newlines when stored on one line
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ---- AI explanations (optional; without a key, deterministic explanations are used) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
